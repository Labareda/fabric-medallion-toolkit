table 'Fact Test'
	lineageTag: 635f9f6e-87ea-4936-9e88-6c04f8731368

	measure 'Latest Run Date' = CALCULATE(MAX('Fact Test'[Started On]), 'Fact Test'[Is Latest] = TRUE)
		formatString: Long Date
		lineageTag: 5a8fad44-1c65-4291-8d7d-879cf712cc8b

	measure 'Latest Test Status' = CALCULATE(SELECTEDVALUE('Dim Test Status'[Test Status Name]), 'Fact Test'[Is Latest] = TRUE)
		lineageTag: c74e73e9-29f5-4f59-80bb-8b6eac278ea9

	measure 'Latest Executor' = CALCULATE(SELECTEDVALUE('Dim Resource'[Resource Name]), 'Fact Test'[Is Latest] = TRUE)
		lineageTag: 02a72f8d-ec1b-4628-ae8b-e75ef23aae26

	measure 'Test Summary' = SELECTEDVALUE('Dim Issue'[Issue Summary])
		lineageTag: 6ab6b4b5-f791-45e8-860f-af02037a76ac

	measure 'Total Tests' = DISTINCTCOUNT('Fact Test'[Test Issue Key])
		formatString: 0
		lineageTag: 575c807b-f6c5-44f6-8e03-cf4b180e1301

	measure 'Tests Passed' = CALCULATE(SUM('Fact Test'[Is Passed]), 'Fact Test'[Is Latest] = TRUE)
		formatString: 0
		lineageTag: b078332d-7026-4e9a-ad80-d4cc001a7dde

	measure 'Tests Failed' = CALCULATE(SUM('Fact Test'[Is Failed]), 'Fact Test'[Is Latest] = TRUE)
		formatString: 0
		lineageTag: a99add48-b0aa-4046-88aa-56f76e24df6f

	measure 'Pass Rate %' = DIVIDE([Tests Passed], [Total Tests])
		formatString: 0.0%
		lineageTag: 759175e8-e13d-4d04-a822-577f52301860

	measure 'Total Runs' = COUNTROWS('Fact Test')
		formatString: 0
		lineageTag: e4a6a742-afad-41e6-8c8f-7f24b30f49b3

	measure 'Runs Passed' = SUM('Fact Test'[Is Passed])
		formatString: 0
		lineageTag: 2fb45764-9f6f-40ed-bd0d-ce0ba2297256

	measure 'Runs Failed' = SUM('Fact Test'[Is Failed])
		formatString: 0
		lineageTag: 264d6876-37a7-467e-b9e7-e3696aa79700

	measure 'Blocked Test Missing a Blocking Link' = ```

			    COUNTROWS(
			        FILTER(
			            ADDCOLUMNS(
			                SUMMARIZE('Fact Test', 'Fact Test'[Test Issue Key]),
			                "@IsBlocked", CALCULATE([Latest Test Status]) = "Blocked",
			                "@HasLink", CALCULATE(COUNTROWS('Bridge Issue Link'), 'Bridge Issue Link'[Link Label] = "is blocked by") > 0
			            ),
			            [@IsBlocked] = TRUE && [@HasLink] = FALSE
			        )
			    )
			```
		formatString: 0
		lineageTag: 9f3912aa-8ee2-4b90-9827-09a3ed8851e1

