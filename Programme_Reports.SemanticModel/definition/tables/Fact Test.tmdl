table 'Fact Test'
	lineageTag: 46e00e0e-8007-4424-87bf-b1a1eab6c5fb

	measure 'Blocked Test Missing a Blocking Link' = ```
			
			    COUNTROWS(
			        FILTER(
			            ADDCOLUMNS(
			                SUMMARIZE('Fact Test', 'Fact Test'[Test Fact Key]),
			                "@IsBlocked", CALCULATE(MAX('Fact Test'[Is Blocked])),
			                "@HasLink", CALCULATE([Has Blocking Link])
			            ),
			            [@IsBlocked] = TRUE && [@HasLink] = FALSE
			        )
			    )
			```
		lineageTag: e1a1b9ea-7690-4a92-86b5-93739040d5cb

	measure 'Blocking Issue Codes' = ```

			    CALCULATE(
			        CONCATENATEX('Bridge Issue Link', 'Bridge Issue Link'[Linked Issue Code], ","),
			        'Bridge Issue Link'[Link Type Name] = "Blocks",
			        'Bridge Issue Link'[Direction] = "Inward",
			        USERELATIONSHIP('Fact Test'[Test Issue Key], 'Dim Issue'[Issue Key])
			    )
			```
		lineageTag: b516ec56-4294-4ba6-96bb-9b0f5abdd5e5

	measure 'Has Blocking Link' = ```

			    CALCULATE(
			        COUNTROWS('Bridge Issue Link'),
			        'Bridge Issue Link'[Link Type Name] = "Blocks",
			        'Bridge Issue Link'[Direction] = "Inward",
			        USERELATIONSHIP('Fact Test'[Test Issue Key], 'Dim Issue'[Issue Key])
			    ) > 0
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 850d874f-324e-42c4-8f1e-2bb0c143e62c

	measure 'Test Summary' = ```

			    CALCULATE(
			        SELECTEDVALUE('Dim Issue'[Issue Summary]),
			        USERELATIONSHIP('Fact Test'[Test Issue Key], 'Dim Issue'[Issue Key])
			    )
			```
		lineageTag: 3a7c5e91-2f4d-48b6-9e1a-6d8c0f2b5e73

	measure 'Pass Rate %' = DIVIDE([Tests Passed], [Total Tests])
		lineageTag: aef3d7c4-4653-47a5-9dbc-52ffe5407faf

	measure 'Tests Failed' = CALCULATE([Total Tests], 'Fact Test'[Is Fail] = TRUE)
		lineageTag: 348317e6-c2ae-4a49-840c-5429db8068fb

	measure 'Tests Not Run' = CALCULATE([Total Tests], 'Fact Test'[Is Not Run] = TRUE)
		lineageTag: 7a2a3bb5-92b0-4eb4-97f8-2ba58814a342

	measure 'Tests Passed' = CALCULATE([Total Tests], 'Fact Test'[Is Pass] = TRUE)
		lineageTag: f9fb9e9f-1317-4083-9ecd-02190c56b00b

	measure 'Total Tests' = SUM('Fact Test'[Test Count])
		formatString: 0
		lineageTag: a478a5ff-bfca-4f99-976a-b3796c4d5a11

