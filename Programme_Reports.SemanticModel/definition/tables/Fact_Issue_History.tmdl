table 'Fact_Issue_History'
	lineageTag: fact_issue_history

	column 'Issue_History_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_History_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Issue_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Valid_From'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: Valid_From
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Issue_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Code

		annotation SummarizationSetBy = Automatic

	column 'Valid_To'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: Valid_To
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Valid_From_Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Valid_From_Date

		annotation SummarizationSetBy = Automatic

	column 'Valid_To_Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Valid_To_Date

		annotation SummarizationSetBy = Automatic

	column 'Is_Current'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Current

		annotation SummarizationSetBy = Automatic

	column 'Status_Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Name

		annotation SummarizationSetBy = Automatic

	column 'From_Status_Name'
		dataType: string
		summarizeBy: none
		sourceColumn: From_Status_Name

		annotation SummarizationSetBy = Automatic

	column 'Story_Points'
		dataType: double
		summarizeBy: none
		sourceColumn: Story_Points

		annotation SummarizationSetBy = Automatic

	column 'Is_Done'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Done

		annotation SummarizationSetBy = Automatic

	column 'Is_Reopen'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Reopen

		annotation SummarizationSetBy = Automatic

	column 'Is_Seed_Period'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Seed_Period

		annotation SummarizationSetBy = Automatic

	column 'Days_In_Period'
		dataType: double
		summarizeBy: none
		sourceColumn: Days_In_Period

		annotation SummarizationSetBy = Automatic

	column 'Hours_In_Period'
		dataType: double
		summarizeBy: none
		sourceColumn: Hours_In_Period

		annotation SummarizationSetBy = Automatic

	column 'Period_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Period_Count

		annotation SummarizationSetBy = Automatic

	column 'Issue_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Project_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Project_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Team_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Team_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Status_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Changed_By_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Changed_By_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	measure 'Avg Days In Status' = AVERAGE('Fact_Issue_History'[Days_In_Period])
		formatString: #,##0.0

	measure 'Reopen Count' = CALCULATE(COUNTROWS('Fact_Issue_History'), 'Fact_Issue_History'[Is_Reopen] = TRUE)

	partition 'Fact_Issue_History' = m
		mode: import
		source =
				let
				    Source = Sql.Database("<YOUR_GOLD_SQL_ENDPOINT>", "Gold"),
				    Data = Source{[Schema="gold",Item="fact_issue_history"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
