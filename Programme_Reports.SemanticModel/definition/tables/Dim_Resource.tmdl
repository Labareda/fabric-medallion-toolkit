table 'Dim_Resource'
	column 'Resource_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Resource_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Resource_Account_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Resource_Account_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Resource_Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Resource_Name

		annotation SummarizationSetBy = Automatic

	column 'Email'
		dataType: string
		summarizeBy: none
		sourceColumn: Email

		annotation SummarizationSetBy = Automatic

	column 'Is_Active'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Active

		annotation SummarizationSetBy = Automatic

	column 'Daily_Capacity_Hours'
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: Daily_Capacity_Hours

		annotation SummarizationSetBy = Automatic

	measure 'Total Daily Capacity (Active, Hrs)' = CALCULATE(SUM('Dim_Resource'[Daily_Capacity_Hours]), 'Dim_Resource'[Is_Active] = TRUE)
		formatString: #,##0.0

	partition 'Dim_Resource' = m
		mode: import
		source =
				let
				    Source = Sql.Database("<YOUR_GOLD_SQL_ENDPOINT>", "Gold"),
				    Data = Source{[Schema="gold",Item="dim_resource"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
