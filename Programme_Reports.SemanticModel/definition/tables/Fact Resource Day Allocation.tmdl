table 'Fact Resource Day Allocation'
	lineageTag: c8cbb311-b920-45cf-8664-1f315e192967

	measure 'Allocated Hours (Total)' = SUM('Fact Resource Day Allocation'[Allocated Hours])
		lineageTag: 60cb320c-08b0-4470-9583-31b023c58e01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conflict Resource Days' = ```
			
			    VAR ResourceDayTable =  
			        SUMMARIZE(
			            'Fact Resource Day Allocation',
			            'Fact Resource Day Allocation'[Resource Key],
			            'Fact Resource Day Allocation'[Date]
			        )
			    VAR Withhoursandcapacity = 
			        ADDCOLUMNS(
			            ResourceDayTable,
			            "@AllocHours", CALCULATE(SUM('Fact Resource Day Allocation'[Allocated Hours])),
			            "@Capacity", CALCULATE(MAX('Dim Resource'[Daily Capacity Hours]))
			        )
			    RETURN
			        COUNTROWS(FILTER(Withhoursandcapacity, [@AllocHours] > [@Capacity]))
			```
		formatString: 0
		lineageTag: 18175793-43ea-446c-b968-f89f68d74f2a

	measure 'Allocated Items' = DISTINCTCOUNT('Fact Resource Allocation'[Issue Key])
		formatString: 0
		lineageTag: 7ca1201c-b875-43d6-9cb1-47da80705cfb

