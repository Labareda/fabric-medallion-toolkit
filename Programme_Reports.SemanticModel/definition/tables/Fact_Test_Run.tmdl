table 'Fact_Test_Run'
	lineageTag: fact_test_run

	column 'Test_Run_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Run_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Run_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Run_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Code

		annotation SummarizationSetBy = Automatic

	column 'Execution_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Execution_Code

		annotation SummarizationSetBy = Automatic

	column 'Execution_Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Execution_Name

		annotation SummarizationSetBy = Automatic

	column 'Test_Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Type

		annotation SummarizationSetBy = Automatic

	column 'Status_Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Status_Name

		annotation SummarizationSetBy = Automatic

	column 'Started_Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Started_Date

		annotation SummarizationSetBy = Automatic

	column 'Finished_Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Finished_Date

		annotation SummarizationSetBy = Automatic

	column 'Duration_Mins'
		dataType: double
		summarizeBy: none
		sourceColumn: Duration_Mins

		annotation SummarizationSetBy = Automatic

	column 'Run_Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: Run_Number

		annotation SummarizationSetBy = Automatic

	column 'Is_Latest_Run'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Latest_Run

		annotation SummarizationSetBy = Automatic

	column 'Is_First_Run'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_First_Run

		annotation SummarizationSetBy = Automatic

	column 'Passed_First_Time'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Passed_First_Time

		annotation SummarizationSetBy = Automatic

	column 'Run_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Run_Count

		annotation SummarizationSetBy = Automatic

	column 'Test_Issue_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Issue_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Status_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Status_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Executor_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Executor_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	measure 'Total Runs' = SUM('Fact_Test_Run'[Run_Count])
		formatString: #,##0

	measure 'First-Time Pass Rate %' = DIVIDE(CALCULATE(SUM('Fact_Test_Run'[Run_Count]), 'Fact_Test_Run'[Passed_First_Time] = TRUE), CALCULATE(SUM('Fact_Test_Run'[Run_Count]), 'Fact_Test_Run'[Is_First_Run] = TRUE))
		formatString: 0.0%

	partition 'Fact_Test_Run' = m
		mode: import
		source =
				let
				    Source = Sql.Database("<YOUR_GOLD_SQL_ENDPOINT>", "Gold"),
				    Data = Source{[Schema="gold",Item="fact_test_run"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
