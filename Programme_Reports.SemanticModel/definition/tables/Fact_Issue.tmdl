table 'Fact_Issue'
	lineageTag: fact_issue

	column 'Issue_Fact_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Fact_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Issue_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Issue_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Issue_Code

		annotation SummarizationSetBy = Automatic

	column 'Story_Points'
		dataType: double
		summarizeBy: none
		sourceColumn: Story_Points

		annotation SummarizationSetBy = Automatic

	column 'Original_Estimate_Hours'
		dataType: double
		summarizeBy: none
		sourceColumn: Original_Estimate_Hours

		annotation SummarizationSetBy = Automatic

	column 'Remaining_Estimate_Hours'
		dataType: double
		summarizeBy: none
		sourceColumn: Remaining_Estimate_Hours

		annotation SummarizationSetBy = Automatic

	column 'Time_Spent_Hours'
