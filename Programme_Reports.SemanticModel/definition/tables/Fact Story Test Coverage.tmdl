/// Story -> Test traceability tree (Story -> Test Set/Plan -> Test -> Linked item, any link type)
table 'Fact Story Test Coverage'
	lineageTag: 8f2c1a44-6b7d-4e91-a0c2-1d3e5f7a9b21

	measure 'Test Count' = DISTINCTCOUNT('Fact Story Test Coverage'[Test Code])
		formatString: 0
		lineageTag: c71a2f38-4d90-4a12-9e64-5b8c0d2e6f43

	measure 'Blocked Test Count' = CALCULATE(DISTINCTCOUNT('Fact Story Test Coverage'[Test Code]), 'Fact Story Test Coverage'[Test Status] = "BLOCKED")
