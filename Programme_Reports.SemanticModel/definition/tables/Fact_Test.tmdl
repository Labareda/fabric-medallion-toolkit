table 'Fact_Test'
	lineageTag: fact_test

	column 'Test_Fact_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Fact_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Set_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Set_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Id
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Set_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Set_Code

		annotation SummarizationSetBy = Automatic

	column 'Test_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Code

		annotation SummarizationSetBy = Automatic

	column 'Parent_Issue_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Parent_Issue_Code

		annotation SummarizationSetBy = Automatic

	column 'Latest_Status'
		dataType: string
		summarizeBy: none
		sourceColumn: Latest_Status

		annotation SummarizationSetBy = Automatic

	column 'Latest_Run_Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Latest_Run_Date

		annotation SummarizationSetBy = Automatic

	column 'Latest_Executor'
		dataType: string
		summarizeBy: none
		sourceColumn: Latest_Executor

		annotation SummarizationSetBy = Automatic

	column 'Execution_Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Execution_Code

		annotation SummarizationSetBy = Automatic

	column 'Run_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Run_Count

		annotation SummarizationSetBy = Automatic

	column 'Pass_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Pass_Count

		annotation SummarizationSetBy = Automatic

	column 'Fail_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Fail_Count

		annotation SummarizationSetBy = Automatic

	column 'Test_Count'
		dataType: int64
		summarizeBy: none
		sourceColumn: Test_Count

		annotation SummarizationSetBy = Automatic

	column 'Is_Pass'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Pass

		annotation SummarizationSetBy = Automatic

	column 'Is_Fail'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Fail

		annotation SummarizationSetBy = Automatic

	column 'Is_Blocked'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Blocked

		annotation SummarizationSetBy = Automatic

	column 'Is_Not_Run'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Not_Run

		annotation SummarizationSetBy = Automatic

	column 'Is_Executed'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is_Executed

		annotation SummarizationSetBy = Automatic

	column 'Test_Set_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Set_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Status_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Status_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Executor_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Executor_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Project_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Project_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Team_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Team_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Test_Issue_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Test_Issue_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Parent_Issue_Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Parent_Issue_Key
		isHidden

		annotation SummarizationSetBy = Automatic

	measure 'Total Tests' = SUM('Fact_Test'[Test_Count])
		formatString: #,##0

	measure 'Tests Passed' = CALCULATE([Total Tests], 'Fact_Test'[Is_Pass] = TRUE)

	measure 'Tests Failed' = CALCULATE([Total Tests], 'Fact_Test'[Is_Fail] = TRUE)

	measure 'Tests Not Run' = CALCULATE([Total Tests], 'Fact_Test'[Is_Not_Run] = TRUE)

	measure 'Pass Rate %' = DIVIDE([Tests Passed], [Total Tests])
		formatString: 0.0%

	measure 'Blocking Issue Codes' = ```

			        CALCULATE(
			            CONCATENATEX('Bridge_Issue_Link', 'Bridge_Issue_Link'[Linked_Issue_Code], ", "),
			            'Bridge_Issue_Link'[Link_Type_Name] = "Blocks",
			            'Bridge_Issue_Link'[Direction] = "Inward"
			        )
			```

	measure 'Has Blocking Link' = ```

			        CALCULATE(
			            COUNTROWS('Bridge_Issue_Link'),
			            'Bridge_Issue_Link'[Link_Type_Name] = "Blocks",
			            'Bridge_Issue_Link'[Direction] = "Inward"
			        ) > 0
			```

	measure 'Blocked Tests Missing a Blocking Link' = ```

			        COUNTROWS(
			            FILTER(
			                ADDCOLUMNS(
			                    SUMMARIZE('Fact_Test', 'Fact_Test'[Test_Fact_Key]),
			                    "@IsBlocked", CALCULATE(MAX('Fact_Test'[Is_Blocked])),
			                    "@HasLink", CALCULATE([Has Blocking Link])
			                ),
			                [@IsBlocked] = TRUE && [@HasLink] = FALSE
			            )
			        )
			```
		formatString: #,##0

	partition 'Fact_Test' = m
		mode: import
		source =
				let
				    Source = Sql.Database("<YOUR_GOLD_SQL_ENDPOINT>", "Gold"),
				    Data = Source{[Schema="gold",Item="fact_test"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
