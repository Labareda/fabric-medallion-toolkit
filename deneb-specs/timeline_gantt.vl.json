{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Timeline Gantt (free Deneb replacement for Gantt Chart xViz). Side-by-side layout: left text columns (Name tree / Lead / Resources) row-aligned with the Gantt bars on the right, like the paid visual. Bind to Deneb's Values well: Dim Issue[Issue Code], Dim Issue[Summary], Dim Issue[Sort Path], Dim Issue[Status Name], Dim Issue[Is Milestone], Dim Issue[Lead Name], Dim Issue[Resource Names], Dim Issue[Level 1..7], Fact Issue[Planned Start Date], Fact Issue[Planned End Date]. Indentation is derived from how many Level_n are populated, so NO Gold change is needed.",
  "config": {
    "view": { "stroke": "transparent" },
    "font": "Segoe UI",
    "axis": { "labelColor": "#333333", "titleColor": "#333333", "gridColor": "#EEEEEE", "domain": false, "ticks": false },
    "legend": { "orient": "top", "title": null },
    "concat": { "spacing": 0 },
    "title": { "anchor": "start", "fontSize": 11, "color": "#666666", "dy": -2 }
  },
  "data": { "name": "dataset" },
  "transform": [
    { "filter": "datum['Planned Start Date'] != null && datum['Planned End Date'] != null" },
    {
      "calculate": "(datum['Level 1']!=null&&datum['Level 1']!=''?1:0)+(datum['Level 2']!=null&&datum['Level 2']!=''?1:0)+(datum['Level 3']!=null&&datum['Level 3']!=''?1:0)+(datum['Level 4']!=null&&datum['Level 4']!=''?1:0)+(datum['Level 5']!=null&&datum['Level 5']!=''?1:0)+(datum['Level 6']!=null&&datum['Level 6']!=''?1:0)+(datum['Level 7']!=null&&datum['Level 7']!=''?1:0)",
      "as": "Depth"
    },
    { "calculate": "datum['Issue Code'] + ': ' + datum['Summary']", "as": "NameText" }
  ],
  "resolve": { "scale": { "y": "shared" } },
  "hconcat": [
    {
      "title": "Name",
      "width": 260,
      "height": { "step": 16 },
      "mark": { "type": "text", "align": "left", "baseline": "middle", "fontSize": 10, "limit": 250, "tooltip": true },
      "encoding": {
        "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
        "x": {
          "field": "Depth",
          "type": "quantitative",
          "scale": { "domain": [ 1, 7 ], "range": [ 2, 86 ] },
          "axis": null
        },
        "text": { "field": "NameText" },
        "tooltip": [ { "field": "NameText", "title": "Task" } ]
      }
    },
    {
      "title": "Lead",
      "width": 82,
      "height": { "step": 16 },
      "mark": { "type": "text", "align": "left", "baseline": "middle", "fontSize": 10, "limit": 78, "color": "#333333" },
      "encoding": {
        "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
        "text": { "field": "Lead Name" }
      }
    },
    {
      "title": "Resources",
      "width": 100,
      "height": { "step": 16 },
      "mark": { "type": "text", "align": "left", "baseline": "middle", "fontSize": 10, "limit": 96, "color": "#333333" },
      "encoding": {
        "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
        "text": { "field": "Resource Names" }
      }
    },
    {
      "width": 560,
      "height": { "step": 16 },
      "layer": [
        {
          "description": "Task bars",
          "mark": { "type": "bar", "height": { "band": 0.62 }, "cornerRadius": 2, "tooltip": true },
          "encoding": {
            "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
            "x": { "field": "Planned Start Date", "type": "temporal", "axis": { "title": null, "format": "%b %Y", "grid": true, "orient": "top" } },
            "x2": { "field": "Planned End Date" },
            "color": { "field": "Status Name", "type": "nominal", "legend": { "title": "Status" } },
            "tooltip": [
              { "field": "Issue Code", "title": "Issue" },
              { "field": "Summary", "title": "Summary" },
              { "field": "Status Name", "title": "Status" },
              { "field": "Lead Name", "title": "Lead" },
              { "field": "Resource Names", "title": "Resources" },
              { "field": "Planned Start Date", "type": "temporal", "title": "Start", "format": "%d %b %Y" },
              { "field": "Planned End Date", "type": "temporal", "title": "End", "format": "%d %b %Y" }
            ]
          }
        },
        {
          "description": "Issue label at bar end",
          "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 4, "fontSize": 9, "color": "#888888", "limit": 220 },
          "encoding": {
            "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
            "x": { "field": "Planned End Date", "type": "temporal" },
            "text": { "field": "NameText" }
          }
        },
        {
          "description": "Milestone diamonds",
          "transform": [ { "filter": "datum['Is Milestone'] == true" } ],
          "mark": { "type": "point", "shape": "diamond", "size": 80, "filled": true, "color": "#B21C1A", "tooltip": true },
          "encoding": {
            "y": { "field": "Issue Code", "type": "nominal", "sort": { "field": "Sort Path", "order": "ascending" }, "axis": null },
            "x": { "field": "Planned End Date", "type": "temporal" }
          }
        },
        {
          "description": "Today line",
          "data": { "values": [ {} ] },
          "mark": { "type": "rule", "color": "#B21C1A", "strokeWidth": 1.5, "strokeDash": [ 4, 3 ] },
          "encoding": { "x": { "datum": { "expr": "now()" }, "type": "temporal" } }
        }
      ]
    }
  ]
}
