{
  "source_name": "jira",
  "base_url": "https://yourcompany.atlassian.net",
  "auth": {
    "kind": "basic",
    "username": "ana@yourcompany.com",
    "secret_akv_name": "your-keyvault-name",
    "secret_akv_secret_name": "jira-api-token"
  },
  "request_timeout_seconds": 30,
  "max_retries": 5,
  "entities": [
    {
      "entity_name": "issues",
      "endpoint_path": "/rest/api/3/search/jql",
      "http_method": "GET",
      "pagination_style": "cursor",
      "page_size": 100,
      "cursor_param_name": "nextPageToken",
      "cursor_page_size_param_name": "maxResults",
      "records_json_path": "issues",
      "next_cursor_json_path": "nextPageToken",
      "natural_key_field": "key",
      "extra_params": { "jql": "project IS NOT EMPTY ORDER BY created DESC", "fields": "*all", "expand": "changelog" },
      "incremental_column": "fields.updated",
      "watermark_params_template": { "jql": "project IS NOT EMPTY AND updated >= '{watermark}' ORDER BY updated" },
      "initial_watermark_value": "2026-01-01 00:00",
      "silver": {
        "natural_key_columns": ["ticket_key"],
        "dedup_order_column": "_extracted_at",
        "column_mappings": [
          { "target_column": "ticket_key", "json_path": "key", "data_type": "string" },
          { "target_column": "summary", "json_path": "fields.summary", "data_type": "string" },
          { "target_column": "status", "json_path": "fields.status.name", "data_type": "string" },
          { "target_column": "assignee", "json_path": "fields.assignee.displayName", "data_type": "string" },
          { "target_column": "assignee_account_id", "json_path": "fields.assignee.accountId", "data_type": "string" },
          { "target_column": "reporter", "json_path": "fields.reporter.displayName", "data_type": "string" },
          { "target_column": "creator", "json_path": "fields.creator.displayName", "data_type": "string" },
          { "target_column": "issue_type", "json_path": "fields.issuetype.name", "data_type": "string" },
          { "target_column": "project_key", "json_path": "fields.project.key", "data_type": "string" },
          { "target_column": "created_at", "json_path": "fields.created", "data_type": "timestamp",
            "date_format": "yyyy-MM-dd'T'HH:mm:ss.SSSZ" },
          { "target_column": "updated_at", "json_path": "fields.updated", "data_type": "timestamp",
            "date_format": "yyyy-MM-dd'T'HH:mm:ss.SSSZ" },
          { "target_column": "due_date", "json_path": "fields.duedate", "data_type": "date" },
          { "target_column": "start_date", "json_path": "fields.customfield_10015", "data_type": "date" },
          { "target_column": "resolution_date", "json_path": "fields.resolutiondate", "data_type": "timestamp",
            "date_format": "yyyy-MM-dd'T'HH:mm:ss.SSSZ" },
          { "target_column": "resolution", "json_path": "fields.resolution.name", "data_type": "string" },
          { "target_column": "priority", "json_path": "fields.priority.name", "data_type": "string" },
          { "target_column": "parent_key", "json_path": "fields.parent.key", "data_type": "string" },
          { "target_column": "labels", "json_path": "fields.labels", "data_type": "string" },
          { "target_column": "original_estimate_seconds", "json_path": "fields.timeoriginalestimate", "data_type": "long" },
          { "target_column": "time_spent_seconds", "json_path": "fields.timespent", "data_type": "long" },
          { "target_column": "remaining_estimate_seconds", "json_path": "fields.timeestimate", "data_type": "long" },
          { "target_column": "votes", "json_path": "fields.votes.votes", "data_type": "int" },
          { "target_column": "watch_count", "json_path": "fields.watches.watchCount", "data_type": "int" }
        ]
      }
    },
    {
      "entity_name": "projects",
      "endpoint_path": "/rest/api/3/project/search",
