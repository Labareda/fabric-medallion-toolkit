{
  "source_name": "jira",
  "base_url": "https://yourcompany.atlassian.net",
  "auth": {
    "kind": "basic",
    "username": "ana@yourcompany.com",
    "secret_akv_name": "your-keyvault-name",
    "secret_akv_secret_name": "jira-api-token"
  },
  "request_timeout_seconds": 30,
  "max_retries": 5,
  "entities": [
    {
      "entity_name": "issues",
      "endpoint_path": "/rest/api/3/search/jql",
      "http_method": "GET",
      "pagination_style": "cursor",
      "page_size": 100,
      "cursor_param_name": "nextPageToken",
      "cursor_page_size_param_name": "maxResults",
      "records_json_path": "issues",
      "next_cursor_json_path": "nextPageToken",
      "natural_key_field": "key",
      "extra_params": {
        "jql": "project IS NOT EMPTY ORDER BY created DESC",
        "fields": "*all",
        "expand": "changelog"
      },
      "incremental_column": "fields.updated",
      "watermark_params_template": {
        "jql": "project IS NOT EMPTY AND updated >= '{watermark}' ORDER BY updated"
      },
      "initial_watermark_value": "2021-01-01 00:00"
    },
    {
      "entity_name": "projects",
      "endpoint_path": "/rest/api/3/project/search",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "key",
      "extra_params": {
        "expand": "description,lead,url,projectKeys,issueTypes,permissions,insight"
      },
      "total_json_path": "total"
    },
    {
      "entity_name": "users",
      "endpoint_path": "/rest/api/3/users/search",
      "http_method": "GET",
      "pagination_style": "offset_limit",
      "page_size": 200,
      "records_json_path": "",
      "natural_key_field": "accountId"
    },
    {
      "entity_name": "issuetypes",
      "endpoint_path": "/rest/api/3/issuetype",
      "http_method": "GET",
      "pagination_style": "none",
      "records_json_path": "",
      "natural_key_field": "id"
    },
    {
      "entity_name": "statuses",
      "endpoint_path": "/rest/api/3/status",
      "http_method": "GET",
      "pagination_style": "none",
      "records_json_path": "",
      "natural_key_field": "id"
    },
    {
      "entity_name": "priorities",
      "endpoint_path": "/rest/api/3/priority/search",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "resolutions",
      "endpoint_path": "/rest/api/3/resolution/search",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "project_roles",
      "endpoint_path": "/rest/api/3/role",
      "http_method": "GET",
      "pagination_style": "none",
      "records_json_path": "",
      "natural_key_field": "id"
    },
    {
      "entity_name": "labels",
      "endpoint_path": "/rest/api/3/label",
      "http_method": "GET",
      "pagination_style": "offset_limit",
      "page_size": 200,
      "total_json_path": "total",
      "records_json_path": "values",
      "natural_key_field": ""
    },
    {
      "entity_name": "audit_logs",
      "endpoint_path": "/rest/api/3/auditing/record",
      "http_method": "GET",
      "pagination_style": "offset_limit",
      "page_size": 1000,
      "total_json_path": "total",
      "records_json_path": "records",
      "natural_key_field": "id"
    },
    {
      "entity_name": "boards",
      "endpoint_path": "/rest/agile/1.0/board",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "fields",
      "endpoint_path": "/rest/api/3/field",
      "http_method": "GET",
      "pagination_style": "none",
      "records_json_path": "",
      "natural_key_field": "id"
    },
    {
      "entity_name": "issue_link_types",
      "endpoint_path": "/rest/api/3/issueLinkType",
      "http_method": "GET",
      "pagination_style": "none",
      "records_json_path": "issueLinkTypes",
      "natural_key_field": "id"
    },
    {
      "entity_name": "filters",
      "endpoint_path": "/rest/api/3/filter/search",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "groups",
      "endpoint_path": "/rest/api/3/group/bulk",
      "http_method": "GET",
      "pagination_style": "offset_limit",
      "page_size": 50,
      "records_json_path": "groups",
      "natural_key_field": "groupId",
      "total_json_path": "total"
    },
    {
      "entity_name": "dashboards",
      "endpoint_path": "/rest/api/3/dashboard",
      "http_method": "GET",
      "pagination_style": "offset_limit",
      "page_size": 20,
      "records_json_path": "dashboards",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "screens",
      "endpoint_path": "/rest/api/3/screens",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id",
      "total_json_path": "total"
    },
    {
      "entity_name": "workflows",
      "endpoint_path": "/rest/api/3/workflow/search",
      "http_method": "GET",
      "pagination_style": "page_number",
      "page_size": 50,
      "records_json_path": "values",
      "natural_key_field": "id.entityId",
      "total_json_path": "total"
    }
  ]
}