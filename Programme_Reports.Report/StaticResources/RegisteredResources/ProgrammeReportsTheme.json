{
  "name": "ProgrammeReportsTheme",
  "dataColors": [
    "#0E6E68",
    "#2A3A5C",
    "#B4791C",
    "#8A8474",
    "#C3413B",
    "#4C8577",
    "#6B5B95",
    "#3F6B8A",
    "#A6763B",
    "#6E8B3D",
    "#9C5A6B",
    "#4A5568"
  ],
  "foreground": "#1B2130",
  "foregroundNeutralSecondary": "#55605E",
  "foregroundNeutralTertiary": "#8A8474",
  "background": "#FBFAF7",
  "backgroundLight": "#EDEAE1",
  "backgroundNeutral": "#E3E0D6",
  "tableAccent": "#0E6E68",
  "good": "#2F7D53",
  "neutral": "#B4791C",
  "bad": "#C3413B",
  "maximum": "#0E6E68",
  "center": "#B4791C",
  "minimum": "#DCEEEB",
  "null": "#8A8474",
  "hyperlink": "#0E6E68",
  "visitedHyperlink": "#0B5652",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2130"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2130"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2130"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#55605E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FBFAF7"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "width": 1,
            "color": {
              "solid": {
                "color": "#E3E0D6"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E3E0D6"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A8474"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEAE1"
              }
            },
            "rowPadding": 6
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A8474"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "showExpandCollapseButtons": true,
            "legacyStyleDisabled": true
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "layout": [
          {
            "$id": "default",
            "cellPadding": 14,
            "paddingIndividual": false,
            "paddingUniform": 14,
            "backgroundShow": true
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontColor": {
              "solid": {
                "color": "#0E6E68"
              }
            }
          }
        ],
        "label": [
          {
            "$id": "default",
            "position": "aboveValue",
            "fontColor": {
              "solid": {
                "color": "#8A8474"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "lineColor": {
              "solid": {
                "color": "#E3E0D6"
              }
            }
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 6
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "general": [
          {
            "responsive": true
          }
        ],
        "items": [
          {
            "padding": 4,
            "accessibilityContrastProperties": true,
            "background": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#1B2130"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F6F5F1"
              }
            }
          }
        ],
        "background": [
          {
            "transparency": 100
          }
        ]
      }
    }
  }
}
