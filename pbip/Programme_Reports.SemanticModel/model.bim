      {
        "name": "Fact_Test",
        "columns": [
          {
            "name": "Test_Fact_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Test_Set_Id",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Test_Id",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Test_Set_Code",
            "dataType": "string"
          },
          {
            "name": "Test_Code",
            "dataType": "string"
          },
          {
            "name": "Parent_Issue_Code",
            "dataType": "string"
          },
          {
            "name": "Latest_Run_Date",
            "dataType": "dateTime"
          },
          {
            "name": "Run_Count",
            "dataType": "int64"
          },
          {
            "name": "Pass_Count",
            "dataType": "int64"
          },
          {
            "name": "Fail_Count",
            "dataType": "int64"
          },
          {
            "name": "Test_Count",
            "dataType": "int64"
          },
          {
            "name": "Is_Pass",
            "dataType": "boolean"
          },
          {
            "name": "Is_Fail",
            "dataType": "boolean"
          },
          {
            "name": "Is_Blocked",
            "dataType": "boolean"
          },
          {
            "name": "Is_Not_Run",
            "dataType": "boolean"
          },
          {
            "name": "Is_Executed",
            "dataType": "boolean"
          },
          {
            "name": "Test_Set_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Test_Status_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Executor_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Test_Issue_Key",
            "dataType": "string",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fact_Test",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = Lakehouse.Contents(null){[Id=\"Gold\", Kind=\"Workspace\"]}[Data],\n    Schema = Source{[Schema=\"gold\",Item=\"fact_test\"]}[Data]\nin Schema"
            }
          }
        ],
        "measures": [
          {
            "name": "Tests",
            "expression": "COUNTROWS('Fact_Test')",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Passed",
            "expression": "CALCULATE(COUNTROWS('Fact_Test'), 'Fact_Test'[Is_Pass] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Failed",
            "expression": "CALCULATE(COUNTROWS('Fact_Test'), 'Fact_Test'[Is_Fail] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Blocked",
            "expression": "CALCULATE(COUNTROWS('Fact_Test'), 'Fact_Test'[Is_Blocked] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Not Run",
            "expression": "CALCULATE(COUNTROWS('Fact_Test'), 'Fact_Test'[Is_Not_Run] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Executed",
            "expression": "CALCULATE(COUNTROWS('Fact_Test'), 'Fact_Test'[Is_Executed] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Unique",
            "expression": "DISTINCTCOUNT('Fact_Test'[Test_Code])",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Tests Passed (Unique)",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact_Test'[Test_Code]), 'Fact_Test'[Is_Pass] = TRUE())",
            "displayFolder": "Test Counts"
          },
          {
            "name": "Pass Rate %",
            "expression": "DIVIDE([Tests Passed], [Tests])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Pass Rate (Executed) %",
            "expression": "DIVIDE([Tests Passed], [Tests Executed])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Programme Pass Rate %",
            "expression": "DIVIDE([Tests Passed (Unique)], [Tests Unique])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Execution Progress %",
            "expression": "DIVIDE([Tests Executed], [Tests])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Test Set RAG",
            "expression": "SWITCH(TRUE(),\n    [Tests] = 0, \"Grey\",\n    [Tests Failed] > 0, \"Red\",\n    [Tests Not Run] > 0, \"Amber\",\n    [Pass Rate %] = 1, \"Green\",\n    \"Amber\")",
            "displayFolder": "Test Status"
          }
        ]
      },
