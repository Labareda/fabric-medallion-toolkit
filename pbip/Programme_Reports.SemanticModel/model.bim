            "dataType": "boolean"
          },
          {
            "name": "Is_Reopen",
            "dataType": "boolean"
          },
          {
            "name": "Is_Seed_Period",
            "dataType": "boolean",
            "isHidden": true
          },
          {
            "name": "Days_In_Period",
            "dataType": "double"
          },
          {
            "name": "Hours_In_Period",
            "dataType": "double"
          },
          {
            "name": "Period_Count",
            "dataType": "int64"
          },
          {
            "name": "Issue_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Status_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Changed_By_Key",
            "dataType": "string",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fact_Issue_History",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = Lakehouse.Contents(null){[Id=\"Gold\", Kind=\"Workspace\"]}[Data],\n    Schema = Source{[Schema=\"gold\",Item=\"fact_issue_history\"]}[Data]\nin Schema"
            }
          }
        ],
        "measures": [
          {
            "name": "Open Issues (As At)",
            "expression": "VAR _d = MAX('Dim_Date'[date])\nRETURN CALCULATE(COUNTROWS('Fact_Issue_History'),\n    'Fact_Issue_History'[Valid_From_Date] <= _d,\n    OR(ISBLANK('Fact_Issue_History'[Valid_To_Date]),\n       'Fact_Issue_History'[Valid_To_Date] > _d),\n    'Fact_Issue_History'[Is_Done] = FALSE())",
            "displayFolder": "Trend"
          },
          {
            "name": "Story Points (As At)",
            "expression": "VAR _d = MAX('Dim_Date'[date])\nRETURN CALCULATE(SUM('Fact_Issue_History'[Story_Points]),\n    'Fact_Issue_History'[Valid_From_Date] <= _d,\n    OR(ISBLANK('Fact_Issue_History'[Valid_To_Date]),\n       'Fact_Issue_History'[Valid_To_Date] > _d),\n    'Fact_Issue_History'[Is_Done] = FALSE())",
            "displayFolder": "Trend"
          },
          {
            "name": "Scope Total (As At)",
            "expression": "VAR _d = MAX('Dim_Date'[date])\nRETURN CALCULATE(COUNTROWS('Fact_Issue_History'),\n    'Fact_Issue_History'[Valid_From_Date] <= _d,\n    OR(ISBLANK('Fact_Issue_History'[Valid_To_Date]),\n       'Fact_Issue_History'[Valid_To_Date] > _d))",
            "displayFolder": "Trend"
          },
          {
            "name": "Avg Days In Status",
            "expression": "AVERAGE('Fact_Issue_History'[Days_In_Period])",
            "displayFolder": "Flow",
            "formatString": "0.0"
          },
          {
            "name": "Flow Efficiency %",
            "expression": "VAR _active = CALCULATE(SUM('Fact_Issue_History'[Days_In_Period]), RELATED('Dim_Status'[Flow_State]) = \"Active\")\nVAR _total = SUM('Fact_Issue_History'[Days_In_Period])\nRETURN DIVIDE(_active, _total)",
            "displayFolder": "Flow",
            "formatString": "0%"
          },
          {
            "name": "Reopen Count",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue_History'), 'Fact_Issue_History'[Is_Reopen] = TRUE())",
            "displayFolder": "Flow"
          },
          {
            "name": "Ageing WIP Days",
            "expression": "CALCULATE(AVERAGE('Fact_Issue_History'[Days_In_Period]),\n    'Fact_Issue_History'[Is_Current] = TRUE(),\n    'Fact_Issue_History'[Is_Done] = FALSE())",
            "displayFolder": "Flow",
            "formatString": "0.0"
          },
          {
            "name": "Throughput",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact_Issue_History'[Issue_Key]),\n    'Fact_Issue_History'[Is_Done] = TRUE(),\n    'Fact_Issue_History'[Is_Reopen] = FALSE(),\n    USERELATIONSHIP('Dim_Date'[date], 'Fact_Issue_History'[Valid_From_Date]))",
            "displayFolder": "Flow"
          }
        ]
      },
