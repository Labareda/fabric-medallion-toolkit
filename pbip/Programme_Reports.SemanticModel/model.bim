        "partitions": [
          {
            "name": "Fact_Issue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = Lakehouse.Contents(null){[Id=\"Gold\", Kind=\"Workspace\"]}[Data],\n    Schema = Source{[Schema=\"gold\",Item=\"fact_issue\"]}[Data]\nin Schema"
            }
          }
        ],
        "measures": [
          {
            "name": "Issues",
            "expression": "COUNTROWS('Fact_Issue')",
            "displayFolder": "Counts"
          },
          {
            "name": "Open Issues",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'), 'Fact_Issue'[Is_Done] = FALSE())",
            "displayFolder": "Counts"
          },
          {
            "name": "Done Issues",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'), 'Fact_Issue'[Is_Done] = TRUE())",
            "displayFolder": "Counts"
          },
          {
            "name": "Overdue Issues",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'), 'Fact_Issue'[Is_Overdue] = TRUE())",
            "displayFolder": "Counts"
          },
          {
            "name": "Story Points",
            "expression": "SUM('Fact_Issue'[Story_Points])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Story Points Done",
            "expression": "CALCULATE(SUM('Fact_Issue'[Story_Points]), 'Fact_Issue'[Is_Done] = TRUE())",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "% Complete (Points)",
            "expression": "DIVIDE([Story Points Done], [Story Points])",
            "displayFolder": "Effort",
            "formatString": "0%"
          },
          {
            "name": "% Complete (Count)",
            "expression": "DIVIDE([Done Issues], [Issues])",
            "displayFolder": "Effort",
            "formatString": "0%"
          },
          {
            "name": "Time Spent Hours",
            "expression": "SUM('Fact_Issue'[Time_Spent_Hours])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Remaining Hours",
            "expression": "SUM('Fact_Issue'[Remaining_Estimate_Hours])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Avg Slip Days",
            "expression": "AVERAGEX(FILTER('Fact_Issue', NOT ISBLANK('Fact_Issue'[Slip_Days])), 'Fact_Issue'[Slip_Days])",
            "displayFolder": "Schedule",
            "formatString": "0"
          },
          {
            "name": "Avg Age Days",
            "expression": "AVERAGE('Fact_Issue'[Age_Days])",
            "displayFolder": "Schedule",
            "formatString": "0"
          },
          {
            "name": "Issues Blocked",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'), RELATED('Dim_Status'[Is_Blocked]) = TRUE())",
            "displayFolder": "Counts"
          },
          {
            "name": "Risk Total Score",
            "expression": "SUM('Fact_Issue'[Risk_Total_Score])",
            "displayFolder": "Risk",
            "formatString": "#,0.0"
          },
          {
            "name": "Avg Risk Score",
            "expression": "AVERAGE('Fact_Issue'[Risk_Total_Score])",
            "displayFolder": "Risk",
            "formatString": "#,0.0"
          },
          {
            "name": "Story Points Led",
            "expression": "CALCULATE(SUM('Fact_Issue'[Story_Points]),\n    CROSSFILTER('Dim_Issue'[Issue_Key], 'Fact_Resource_Allocation'[Issue_Key], BOTH))",
            "displayFolder": "Resource"
          },
          {
            "name": "Issues Led",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'),\n    CROSSFILTER('Dim_Issue'[Issue_Key], 'Fact_Resource_Allocation'[Issue_Key], BOTH))",
            "displayFolder": "Resource"
          }
        ]
      },
      {
        "name": "Fact_Issue_History",
        "columns": [
          {
            "name": "Issue_History_Key",
            "dataType": "string",
