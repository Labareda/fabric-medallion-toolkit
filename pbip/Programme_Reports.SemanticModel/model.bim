              "type": "m",
              "expression": "let Source = Lakehouse.Contents(null){[Id=\"Gold\", Kind=\"Workspace\"]}[Data],\n    Schema = Source{[Schema=\"gold\",Item=\"fact_resource_allocation\"]}[Data]\nin Schema"
            }
