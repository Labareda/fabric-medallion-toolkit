          },
          {
            "name": "First Time Pass Rate %",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS('Fact_Test_Run_History'), 'Fact_Test_Run_History'[Passed_First_Time] = TRUE()),\n    CALCULATE(COUNTROWS('Fact_Test_Run_History'), 'Fact_Test_Run_History'[Is_First_Run] = TRUE()))",
            "displayFolder": "Run History",
            "formatString": "0%"
          },
