        ],
        "measures": [
          {
            "name": "People Count",
            "expression": "DISTINCTCOUNT('Fact_Resource_Allocation'[Resource_Key])",
            "displayFolder": "Resource"
          },
          {
            "name": "Leads Count",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact_Resource_Allocation'[Resource_Key]),\n    'Dim_Role'[Role_Name] = \"Lead\")",
            "displayFolder": "Resource"
          },
          {
            "name": "Items per Person",
            "expression": "DIVIDE(DISTINCTCOUNT('Fact_Resource_Allocation'[Issue_Key]),\n    DISTINCTCOUNT('Fact_Resource_Allocation'[Resource_Key]))",
            "displayFolder": "Resource",
            "formatString": "0.0"
          },
          {
            "name": "Unassigned Issues",
            "expression": "CALCULATE(COUNTROWS('Fact_Issue'), RELATED('Dim_Issue'[Has_No_Lead]) = TRUE())",
            "displayFolder": "Resource"
          },
          {
            "name": "Overdue Items Led",
            "expression": "CALCULATE([Overdue Issues],\n    CROSSFILTER('Dim_Issue'[Issue_Key], 'Fact_Resource_Allocation'[Issue_Key], BOTH))",
            "displayFolder": "Resource"
          }
        ]
      },
