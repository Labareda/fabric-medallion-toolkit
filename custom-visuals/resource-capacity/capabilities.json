{
  "privileges": [],
  "dataRoles": [
    { "displayName": "Resource Name", "name": "resource", "kind": "Grouping" },
    { "displayName": "Date", "name": "date", "kind": "Grouping" },
    { "displayName": "Issue Code", "name": "issueCode", "kind": "Grouping" },
    { "displayName": "Item Name", "name": "itemName", "kind": "Grouping" },
    { "displayName": "Status", "name": "status", "kind": "Grouping" },
    { "displayName": "Value (optional)", "name": "value", "kind": "Measure" }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "resource" } },
            { "for": { "in": "date" } },
            { "for": { "in": "issueCode" } },
            { "for": { "in": "itemName" } },
            { "for": { "in": "status" } },
            { "for": { "in": "value" } }
          ],
          "dataReductionAlgorithm": { "window": { "count": 30000 } }
        }
      }
    }
  ],
  "objects": {
    "metric": {
      "properties": {
        "sumValue": { "type": { "bool": true } }
      }
    },
    "appearance": {
      "properties": {
        "rowHeight": { "type": { "numeric": true } },
        "fontSize": { "type": { "numeric": true } },
        "textColor": { "type": { "fill": { "solid": { "color": true } } } },
        "headerColor": { "type": { "fill": { "solid": { "color": true } } } },
        "nameWidth": { "type": { "numeric": true } },
        "weekWidth": { "type": { "numeric": true } }
      }
    },
    "thresholds": {
      "properties": {
        "lowMax": { "type": { "numeric": true } },
        "midMax": { "type": { "numeric": true } },
        "zeroColor": { "type": { "fill": { "solid": { "color": true } } } },
        "lowColor": { "type": { "fill": { "solid": { "color": true } } } },
        "midColor": { "type": { "fill": { "solid": { "color": true } } } },
        "highColor": { "type": { "fill": { "solid": { "color": true } } } },
        "cellTextColor": { "type": { "fill": { "solid": { "color": true } } } }
      }
    },
    "grid": {
      "properties": {
        "gridColor": { "type": { "fill": { "solid": { "color": true } } } },
        "bandedRows": { "type": { "bool": true } },
        "bandColor": { "type": { "fill": { "solid": { "color": true } } } },
        "showTodayLine": { "type": { "bool": true } }
      }
    },
    "legend": {
      "properties": {
        "show": { "type": { "bool": true } },
        "atBottom": { "type": { "bool": true } }
      }
    }
  },
  "supportsHighlight": false,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true
}
