            "dataType": "string",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fact Test",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Lakehouse.Contents(null){[Id=\"Gold\",Kind=\"Workspace\"]}[Data],\n    t = Source{[Schema=\"gold\",Item=\"fact_test\"]}[Data]\nin t"
            }
          }
        ],
        "measures": [
          {
            "name": "Tests",
            "expression": "COUNTROWS('Fact Test')",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Passed",
            "expression": "CALCULATE([Tests],'Fact Test'[Is_Pass]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Failed",
            "expression": "CALCULATE([Tests],'Fact Test'[Is_Fail]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Blocked",
            "expression": "CALCULATE([Tests],'Fact Test'[Is_Blocked]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Not Run",
            "expression": "CALCULATE([Tests],'Fact Test'[Is_Not_Run]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Executed",
            "expression": "CALCULATE([Tests],'Fact Test'[Is_Executed]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Unique",
            "expression": "DISTINCTCOUNT('Fact Test'[Test_Code])",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Tests Passed (Unique)",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact Test'[Test_Code]),'Fact Test'[Is_Pass]=TRUE())",
            "displayFolder": "Test Counts",
            "formatString": "#,0"
          },
          {
            "name": "Pass Rate %",
            "expression": "DIVIDE([Tests Passed],[Tests])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Pass Rate (Executed) %",
            "expression": "DIVIDE([Tests Passed],[Tests Executed])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Programme Pass Rate %",
            "expression": "DIVIDE([Tests Passed (Unique)],[Tests Unique])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Execution Progress %",
            "expression": "DIVIDE([Tests Executed],[Tests])",
            "displayFolder": "Test Rates",
            "formatString": "0%"
          },
          {
            "name": "Test Set RAG",
            "expression": "SWITCH(TRUE(),[Tests]=0,\"Grey\",[Tests Failed]>0,\"Red\",[Tests Not Run]>0,\"Amber\",[Pass Rate %]=1,\"Green\",\"Amber\")",
            "displayFolder": "Test Status"
          }
        ]
      },
