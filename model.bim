            "dataType": "boolean"
          },
          {
            "name": "Issue_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Project_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Status_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Priority_Key",
            "dataType": "string",
