            "expression": "CALCULATE([Runs],'Fact TestRunHistory'[Is_Pass]=TRUE())",
            "displayFolder": "Run History",
            "formatString": "#,0"
          },
          {
            "name": "Pass Rate Trend %",
            "expression": "DIVIDE([Runs Passed],[Runs])",
            "displayFolder": "Run History",
            "formatString": "0%"
          },
          {
            "name": "First Time Pass Rate %",
            "expression": "DIVIDE(\n    CALCULATE([Runs],'Fact TestRunHistory'[Passed_First_Time]=TRUE()),\n    CALCULATE([Runs],'Fact TestRunHistory'[Is_First_Run]=TRUE()))",
            "displayFolder": "Run History",
            "formatString": "0%"
          },
          {
            "name": "Avg Duration Mins",
            "expression": "AVERAGE('Fact TestRunHistory'[Duration_Mins])",
            "displayFolder": "Run History",
            "formatString": "0.0"
          }
        ]
