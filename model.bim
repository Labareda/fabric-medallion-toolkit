        ],
        "partitions": [
          {
            "name": "Fact Issue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Lakehouse.Contents(null){[Id=\"Gold\",Kind=\"Workspace\"]}[Data],\n    t = Source{[Schema=\"gold\",Item=\"fact_issue\"]}[Data]\nin t"
            }
          }
        ],
        "measures": [
          {
            "name": "Issues",
            "expression": "COUNTROWS('Fact Issue')",
            "displayFolder": "Counts",
            "formatString": "#,0"
          },
          {
            "name": "Open Issues",
            "expression": "CALCULATE(COUNTROWS('Fact Issue'),'Fact Issue'[Is_Done]=FALSE())",
            "displayFolder": "Counts",
            "formatString": "#,0"
          },
          {
            "name": "Done Issues",
            "expression": "CALCULATE(COUNTROWS('Fact Issue'),'Fact Issue'[Is_Done]=TRUE())",
            "displayFolder": "Counts",
            "formatString": "#,0"
          },
          {
            "name": "Overdue Issues",
            "expression": "CALCULATE(COUNTROWS('Fact Issue'),'Fact Issue'[Is_Overdue]=TRUE())",
            "displayFolder": "Counts",
            "formatString": "#,0"
          },
          {
            "name": "Issues Blocked",
            "expression": "CALCULATE(COUNTROWS('Fact Issue'),RELATED('Dim Status'[Is_Blocked])=TRUE())",
            "displayFolder": "Counts",
            "formatString": "#,0"
          },
          {
            "name": "Story Points",
            "expression": "SUM('Fact Issue'[Story_Points])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Story Points Done",
            "expression": "CALCULATE(SUM('Fact Issue'[Story_Points]),'Fact Issue'[Is_Done]=TRUE())",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "% Complete (Count)",
            "expression": "DIVIDE([Done Issues],[Issues])",
            "displayFolder": "Effort",
            "formatString": "0%"
          },
          {
            "name": "% Complete (Points)",
            "expression": "DIVIDE([Story Points Done],[Story Points])",
            "displayFolder": "Effort",
            "formatString": "0%"
          },
          {
            "name": "Remaining Hours",
            "expression": "SUM('Fact Issue'[Remaining_Estimate_Hours])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Time Spent Hours",
            "expression": "SUM('Fact Issue'[Time_Spent_Hours])",
            "displayFolder": "Effort",
            "formatString": "#,0.0"
          },
          {
            "name": "Issues Led",
            "expression": "CALCULATE([Issues],\n    CROSSFILTER('Dim Issue'[Issue_Key],'Fact ResourceAllocation'[Issue_Key],BOTH))",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Open Issues Led",
            "expression": "CALCULATE([Open Issues],\n    CROSSFILTER('Dim Issue'[Issue_Key],'Fact ResourceAllocation'[Issue_Key],BOTH))",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Overdue Items Led",
            "expression": "CALCULATE([Overdue Issues],\n    CROSSFILTER('Dim Issue'[Issue_Key],'Fact ResourceAllocation'[Issue_Key],BOTH))",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Story Points Led",
            "expression": "CALCULATE([Story Points],\n    CROSSFILTER('Dim Issue'[Issue_Key],'Fact ResourceAllocation'[Issue_Key],BOTH))",
            "displayFolder": "Resource",
            "formatString": "#,0.0"
          }
        ]
      },
