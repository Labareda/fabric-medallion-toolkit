              "type": "m",
              "expression": "let\n    Source = Lakehouse.Contents(null){[Id=\"Gold\",Kind=\"Workspace\"]}[Data],\n    t = Source{[Schema=\"gold\",Item=\"fact_test_coverage\"]}[Data]\nin t"
            }
          }
        ],
        "measures": [
          {
            "name": "Requirements Total",
            "expression": "DISTINCTCOUNT('Fact TestCoverage'[Requirement_Code])",
            "displayFolder": "Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Requirements Covered",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact TestCoverage'[Requirement_Code]),'Fact TestCoverage'[Is_Covered]=TRUE())",
            "displayFolder": "Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Requirements Uncovered",
            "expression": "[Requirements Total]-[Requirements Covered]",
            "displayFolder": "Coverage",
            "formatString": "#,0"
          },
          {
            "name": "Coverage %",
            "expression": "DIVIDE([Requirements Covered],[Requirements Total])",
            "displayFolder": "Coverage",
            "formatString": "0%"
          }
        ]
      },
