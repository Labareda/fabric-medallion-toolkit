            "dataType": "boolean"
          },
          {
            "name": "Is_Reopen",
            "dataType": "boolean"
          },
          {
            "name": "Days_In_Period",
            "dataType": "double",
            "displayFolder": "Flow"
          },
          {
            "name": "Hours_In_Period",
            "dataType": "double",
            "displayFolder": "Flow"
          },
          {
            "name": "Issue_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Status_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Changed_By_Key",
            "dataType": "string",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fact IssueHistory",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Lakehouse.Contents(null){[Id=\"Gold\",Kind=\"Workspace\"]}[Data],\n    t = Source{[Schema=\"gold\",Item=\"fact_issue_history\"]}[Data]\nin t"
            }
          }
        ],
        "measures": [
          {
            "name": "Open Issues (As At)",
            "expression": "VAR _d=MAX('Dim Date'[date])\nRETURN CALCULATE(COUNTROWS('Fact IssueHistory'),\n    'Fact IssueHistory'[Valid_From_Date]<=_d,\n    OR(ISBLANK('Fact IssueHistory'[Valid_To_Date]),'Fact IssueHistory'[Valid_To_Date]>_d),\n    'Fact IssueHistory'[Is_Done]=FALSE())",
            "displayFolder": "Trend",
            "formatString": "#,0"
          },
          {
            "name": "Scope Total (As At)",
            "expression": "VAR _d=MAX('Dim Date'[date])\nRETURN CALCULATE(COUNTROWS('Fact IssueHistory'),\n    'Fact IssueHistory'[Valid_From_Date]<=_d,\n    OR(ISBLANK('Fact IssueHistory'[Valid_To_Date]),'Fact IssueHistory'[Valid_To_Date]>_d))",
            "displayFolder": "Trend",
            "formatString": "#,0"
          },
          {
            "name": "Flow Efficiency %",
            "expression": "DIVIDE(\n    CALCULATE(SUM('Fact IssueHistory'[Days_In_Period]),RELATED('Dim Status'[Flow_State])=\"Active\"),\n    SUM('Fact IssueHistory'[Days_In_Period]))",
            "displayFolder": "Flow",
            "formatString": "0%"
          },
          {
            "name": "Ageing WIP Days",
            "expression": "CALCULATE(AVERAGE('Fact IssueHistory'[Days_In_Period]),\n    'Fact IssueHistory'[Is_Current]=TRUE(),'Fact IssueHistory'[Is_Done]=FALSE())",
            "displayFolder": "Flow",
            "formatString": "0.0"
          },
          {
            "name": "Reopen Count",
            "expression": "CALCULATE(COUNTROWS('Fact IssueHistory'),'Fact IssueHistory'[Is_Reopen]=TRUE())",
            "displayFolder": "Flow",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Fact ResourceAllocation",
        "columns": [
          {
            "name": "Resource_Allocation_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Allocation_Weight",
            "dataType": "double"
          },
          {
            "name": "Allocation_Count",
            "dataType": "int64"
          },
          {
            "name": "Issue_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Resource_Key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "Role_Key",
            "dataType": "string",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fact ResourceAllocation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Lakehouse.Contents(null){[Id=\"Gold\",Kind=\"Workspace\"]}[Data],\n    t = Source{[Schema=\"gold\",Item=\"fact_resource_allocation\"]}[Data]\nin t"
            }
          }
        ],
        "measures": [
          {
            "name": "People Count",
            "expression": "DISTINCTCOUNT('Fact ResourceAllocation'[Resource_Key])",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Leads Count",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact ResourceAllocation'[Resource_Key]),\n    'Dim ResourceRole'[Role_Name]=\"Lead\")",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Involved Count",
            "expression": "CALCULATE(DISTINCTCOUNT('Fact ResourceAllocation'[Resource_Key]),\n    'Dim ResourceRole'[Role_Name]=\"Involved\")",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Items per Person",
            "expression": "DIVIDE(DISTINCTCOUNT('Fact ResourceAllocation'[Issue_Key]),\n    DISTINCTCOUNT('Fact ResourceAllocation'[Resource_Key]))",
            "displayFolder": "Resource",
            "formatString": "0.0"
          },
          {
            "name": "Unassigned Issues",
            "expression": "CALCULATE(COUNTROWS('Fact Issue'),RELATED('Dim Issue'[Has_No_Lead])=TRUE())",
            "displayFolder": "Resource",
            "formatString": "#,0"
          },
          {
            "name": "Assigned This Period",
            "expression": "CALCULATE([Open Issues Led],\n    CROSSFILTER('Dim Issue'[Issue_Key],'Fact ResourceAllocation'[Issue_Key],BOTH))",
            "displayFolder": "Resource",
            "formatString": "#,0"
          }
        ]
      },
